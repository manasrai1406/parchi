# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parchi
REDIS_URL=redis://localhost:6379
STORAGE_DIR=data/uploads
LOG_LEVEL=info

# AI is off unless you turn it on. Even then, every call needs a person's approval.
AI_ENABLED=false
AI_DAILY_CAP=50
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
