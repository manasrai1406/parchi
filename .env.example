# Copy to .env and fill in. Never commit .env.

APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parchi
REDIS_URL=redis://localhost:6379
STORAGE_DIR=data/uploads
MAX_UPLOAD_MB=20
MAX_FILES_PER_BATCH=50
LOG_LEVEL=info
LOG_DIR=logs

# There is no login in v1. Approvals and fixes are signed with this name.
LOCAL_USER_NAME=local user

# AI is off unless you turn it on. Even then, every call needs a person's approval,
# and only providers with a key can be chosen. Keys stay in this file: never commit it.
AI_ENABLED=false
AI_DAILY_CAP=50
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
AI_TIMEOUT_SECONDS=120

# Database tests drop and rebuild this database. Its name must end in _test.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parchi_test
